# Dependencies.
#
# These were scoped to app/ — but the Vite project is at the REPO ROOT, so a
# plain `npm install` here left 68 packages untracked and one `git add -A`
# from committing them. No leading slash, so these match at any depth and
# cover both the root project and app/.
node_modules/

# Build output
dist/
app/dist/
app/www/

# Android build artifacts
app/android/.gradle/
app/android/**/build/
app/android/local.properties
app/android/.idea/
app/android/app/release/
*.aab
*.apk

# iOS build artifacts
app/ios/App/build/
app/ios/App/DerivedData/
app/ios/App/Pods/
app/ios/capacitor-cordova-ios-plugins/

# Signing keys and anything holding a password — NEVER commit these
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.cer
*.pem
keystore.properties
keystore*.txt
*keystore*.txt
gonogo-website-deploy.txt
support@gonogoboatapp.com.txt
.env
.env.*
.dev.vars

# Cloudflare / Wrangler
.wrangler/
website/node_modules/
website/pub/
website/.deploy/
gonogo-api/node_modules/
gonogo-api/.wrangler/

# Editors
.idea/
.vscode/

# Large media that does not belong in the repo
gonogo reels and video clips/
Barnacle Bill 2.0 (CYBER-PIRATE)/

# OS
.DS_Store
Thumbs.db
