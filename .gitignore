# Dependencies.
#
# These were scoped to app/ — but the Vite project is at the REPO ROOT, so a
# plain `npm install` here left 68 packages untracked and one `git add -A`
# from committing them. No leading slash, so these match at any depth and
# cover both the root project and app/.
node_modules/

# Build output
dist/

# Android build artifacts
app/android/.gradle/
app/android/app/build/
app/android/build/
app/android/local.properties

# Signing keys — NEVER commit these
*.keystore
*.jks

# OS
.DS_Store
Thumbs.db
